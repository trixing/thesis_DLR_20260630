%AXGEndBitmap
GR
GR
GS
[0.24005 0 0 0.24004 0 0.07086] CT
[1 0 0 1 0 0] CT
N
0 0 M
1750 0 L
1750 1312 L
0 1312 L
0 0 L
cp
clip
GS
0 0 translate
700 262 scale
%AXGBeginBitmap: java.awt.image.BufferedImage
{{
/RawData currentfile /ASCII85Decode filter def
/Data RawData /FlateDecode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 262
  /ImageMatrix [700 0 0 262 0 0]
  /Width 700
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
